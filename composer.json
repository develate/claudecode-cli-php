{
    "name": "develate/claudecode-cli-php",
    "description": "A resilient PHP SDK for controlling the Claude Code CLI.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Develate\\ClaudecodeCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Develate\\ClaudecodeCli\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Thorsten",
            "email": "thorsten@develate.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/process": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
